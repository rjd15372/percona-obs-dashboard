# OBS credentials (required)
OBS_USERNAME=
OBS_PASSWORD=
# With obs_instances in config.yaml, per-instance credentials:
# OBS_OPENSUSE_USERNAME= / OBS_OPENSUSE_PASSWORD=
# OBS_LABS_USERNAME=     / OBS_LABS_PASSWORD=
# RabbitMQ credentials per instance (override user:pass in mq.url):
# OBS_LABS_MQ_USERNAME=  / OBS_LABS_MQ_PASSWORD=
OBS_BASE_URL=https://api.opensuse.org

# RabbitMQ
MQ_URL=amqps://opensuse:opensuse@rabbit.opensuse.org:5671/

# Poller
POLL_INTERVAL=5m

# Storage
DB_PATH=/data/obsboard.db
EVENT_RETENTION=7d

# Server
HTTP_PORT=4000
CONFIG_FILE=./config.yaml
