# OBS Dashboard Configuration Example

# OBS (Open Build Service) API settings
obs:
  base_url: https://api.opensuse.org
  username: ""  # Set via OBS_USERNAME env var
  password: ""  # Set via OBS_PASSWORD env var
  # Per-minute cap on background OBS requests (poller + workers).
  # Interactive API requests bypass it. 0 disables limiting.
  minute_request_budget: 60

# Message Queue settings
mq:
  url: amqps://opensuse:opensuse@rabbit.opensuse.org:5671/

# Poller settings
poller:
  interval: 2m

# Data store settings
store:
  db_path: /data/obsboard.db
  event_retention: 7d

# Server settings
server:
  http_port: 8080
  frontend_dir: ""

# Worker pool settings
worker_pool:
  size: 5
  poll_interval: 30s
  queue_size: 512
  # Cap of the per-package backoff ladder: unchanged packages are polled
  # less and less often, up to this interval.
  backoff_max: 5m
  # Minimum number of due packages of the same project to fetch build
  # results with one project-level call instead of per-package calls.
  batch_threshold: 4

# Automatic rebuild trigger for targets stuck in blocked state (works
# around an OBS bug where targets stay blocked after their dependencies
# built). Opt-in; triggers bypass the background OBS rate limiter, like
# manual rebuilds (they are rare and capped per sweep).
unblocker:
  enabled: false
  # Trigger a rebuild when a target has been blocked longer than this.
  threshold: 30m

# Idle mode: pause background OBS polling (discovery + working set) while
# no dashboard client is connected; RabbitMQ events keep the database
# current, and the first client to connect triggers an immediate refresh.
# Enabled by default — set enabled: false to poll continuously.
idle:
  enabled: true
  # Keep polling this long after the last client disconnects.
  linger: 5m
